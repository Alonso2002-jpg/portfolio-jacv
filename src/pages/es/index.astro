---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import WelcomeSection from "../../components/WelcomeSection.astro";
import AboutMe from "../../components/AboutMe.astro";
import Projects from "../../components/Projects.astro";
import ProfessionalExperience from "../../components/ProfessionalExperience.astro";
import Technologies from "../../components/Technologies.astro";
import Contact from "../../components/Contact.astro";
import FooterComponent from "../../components/FooterComponent.astro";
const currentLang = Astro.currentLocale || "es"
---

<Layout>
    <NavBar currentLang={currentLang}/>
    <WelcomeSection/>
    <AboutMe currentLang={currentLang}/>
    <Projects/>
    <ProfessionalExperience currentLang={currentLang}/>
    <Technologies/>
    <Contact/>
    <FooterComponent/>
</Layout>
