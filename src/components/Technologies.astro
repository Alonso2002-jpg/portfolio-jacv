---
import {useTranslations} from "../i18n/utils";
import {languageList} from "../i18n/ui";

const currentLang = Astro.currentLocale || "es";
const t = useTranslations(currentLang as keyof typeof languageList);

// slug → Simple Icons CDN; color → representative brand color (used for icon + hover border)
const rows = [
    {
        label: t("stackLanguages"),
        items: [
            { name: "C#", color: "#68217A" },
            { name: "TypeScript", slug: "typescript", color: "#3178C6" },
            { name: "PHP", slug: "php", color: "#777BB4" },
            { name: "Python", slug: "python", color: "#3776AB" },
            { name: "JavaScript", slug: "javascript", color: "#F7DF1E" },
            { name: "SQL", color: "#4169E1" },
        ],
    },
    {
        label: t("stackFrameworks"),
        items: [
            { name: ".NET", slug: "dotnet", color: "#512BD4" },
            { name: "Angular", slug: "angular", color: "#DD0031" },
            { name: "React", slug: "react", color: "#61DAFB" },
            { name: "Next.js", slug: "nextdotjs", color: "#f4f4f5" },
            { name: "Laravel", slug: "laravel", color: "#FF2D20" },
            { name: "FastAPI", slug: "fastapi", color: "#009688" },
            { name: "Tailwind", slug: "tailwindcss", color: "#06B6D4" },
        ],
    },
    {
        label: t("stackTools"),
        items: [
            { name: "PostgreSQL", slug: "postgresql", color: "#4169E1" },
            { name: "Docker", slug: "docker", color: "#2496ED" },
            { name: "Nginx", slug: "nginx", color: "#009639" },
            { name: "AWS", color: "#FF9900" },
            { name: "Git", slug: "git", color: "#F05032" },
            { name: "CI/CD", slug: "githubactions", color: "#2088FF" },
        ],
    },
];

const iconUrl = (slug: string, color: string) =>
    `https://cdn.simpleicons.org/${slug}/${color.replace('#', '')}`;
---

<section id="stack" class="stack section" data-reveal>
    <p class="section-label">{t("sectionTechnologies")} — 04</p>
    <div class="stack-rows">
        {rows.map((row) => (
            <div class="stack-row">
                <div class="stack-label">{row.label}</div>
                <div class="chips">
                    {row.items.map((item) => (
                        <span class="chip" style={`--accent: ${item.color};`}>
                            {item.slug && (
                                <img class="chip-icon" src={iconUrl(item.slug, item.color)}
                                     alt="" aria-hidden="true" loading="lazy"
                                     onerror="this.style.display='none'" />
                            )}
                            <span class="chip-name">{item.name}</span>
                        </span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .section {
        max-width: 1180px;
        margin: 0 auto;
        padding: clamp(70px, 11vw, 130px) clamp(20px, 5vw, 40px);
        border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .section-label {
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #86868b;
        margin: 0 0 clamp(36px, 6vw, 56px);
    }
    .stack-rows {
        display: flex;
        flex-direction: column;
        gap: clamp(28px, 4vw, 40px);
    }
    .stack-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: clamp(16px, 4vw, 64px);
        align-items: start;
    }
    .stack-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: #86868b;
    }
    .chips {
        grid-column: span 2;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .chip {
        display: inline-flex;
        align-items: center;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        color: #e2e2e6;
        border: 1px solid rgba(255, 255, 255, 0.13);
        border-radius: 8px;
        padding: 9px 15px;
        transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
    }
    .chip-icon {
        width: 0;
        height: 16px;
        opacity: 0;
        overflow: hidden;
        object-fit: contain;
        transition: width 0.25s ease, opacity 0.25s ease, margin-right 0.25s ease;
    }
    .chip:hover {
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        color: #fff;
    }
    .chip:hover .chip-icon {
        width: 16px;
        opacity: 1;
        margin-right: 8px;
    }

    @media (max-width: 640px) {
        .chips { grid-column: span 1; }
    }
    @media (max-width: 600px) {
        .section { padding: 56px 20px; }
        .section-label { margin-bottom: 28px; }
        .stack-rows { gap: 22px; }
        .stack-row { gap: 12px; }
        .chip { font-size: 12px; padding: 8px 13px; }
        .chip-icon { height: 15px; }
    }
    /* On touch devices there is no hover — always show icons */
    @media (hover: none) {
        .chip-icon { width: 16px; opacity: 1; margin-right: 8px; }
        .chip { border-color: color-mix(in srgb, var(--accent) 35%, rgba(255,255,255,0.13)); }
    }
</style>
