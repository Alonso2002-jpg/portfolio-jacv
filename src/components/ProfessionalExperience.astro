---
import {useTranslations} from "../i18n/utils";
import {languageList} from "../i18n/ui";

const { currentLang } = Astro.props
const t = useTranslations(currentLang as keyof typeof languageList)

const company = {
    name: "OriginPath",
    role: t("expRole"),
    period: t("expPeriod"),
    desc: t("expCompanyDesc"),
    projects: [
        { title: t("expAiTitle"), stack: "Python · FastAPI · LLMs", desc: t("expAiDesc") },
        { title: t("expSaasTitle"), stack: "Laravel · Next.js · Stripe", desc: t("expSaasDesc") },
        { title: t("expEmsTitle"), stack: ".NET · Angular · PrimeNG", desc: t("expEmsDesc") },
    ],
}
---

<section id="experience" class="exp section" data-reveal>
    <p class="section-label">{t("sectionExperience")} — 03</p>

    <div class="company">
        <div class="company-head">
            <div class="company-id">
                <span class="company-tag">{t("expCompanyLabel")}</span>
                <h3 class="company-name">{company.name}</h3>
                <p class="company-role">{company.role}</p>
            </div>
            <span class="company-period">{company.period}</span>
        </div>
        <p class="company-desc">{company.desc}</p>

        <div class="projects">
            <p class="projects-label">{t("expProjectsLabel")}</p>
            <div class="proj-list">
                {company.projects.map((pr) => (
                    <div class="proj">
                        <div class="proj-head">
                            <h4 class="proj-title">{pr.title}</h4>
                            <span class="proj-stack">{pr.stack}</span>
                        </div>
                        <p class="proj-desc">{pr.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .section {
        max-width: 1180px;
        margin: 0 auto;
        padding: clamp(70px, 11vw, 130px) clamp(20px, 5vw, 40px);
        border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .section-label {
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #86868b;
        margin: 0 0 clamp(36px, 6vw, 56px);
    }

    /* Company block */
    .company {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 18px;
        background: linear-gradient(160deg, #141417, #0f0f11);
        padding: clamp(24px, 4vw, 40px);
    }
    .company-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }
    .company-tag {
        display: inline-block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #86868b;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        padding: 4px 12px;
        margin-bottom: 14px;
    }
    .company-name {
        font-weight: 800;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        letter-spacing: -0.025em;
        line-height: 1;
        margin: 0;
        color: #f4f4f5;
    }
    .company-role {
        font-weight: 500;
        font-size: 1rem;
        color: #d9d9dd;
        margin: 8px 0 0;
    }
    .company-period {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: #86868b;
        white-space: nowrap;
        padding-top: 6px;
    }
    .company-desc {
        font-weight: 300;
        font-size: 1.02rem;
        line-height: 1.7;
        color: #a6a6ab;
        margin: 24px 0 0;
        max-width: 70ch;
    }

    /* Nested projects */
    .projects {
        margin-top: clamp(28px, 4vw, 40px);
        padding-top: clamp(24px, 3vw, 32px);
        border-top: 1px solid rgba(255, 255, 255, 0.09);
    }
    .projects-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #86868b;
        margin: 0 0 24px;
    }
    .proj-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        border-left: 1px solid rgba(255, 255, 255, 0.12);
        padding-left: clamp(18px, 3vw, 28px);
        margin-left: 4px;
    }
    .proj {
        position: relative;
        padding: 18px 0;
    }
    .proj + .proj { border-top: 1px solid rgba(255, 255, 255, 0.06); }
    .proj::before {
        content: "";
        position: absolute;
        left: calc(-1 * clamp(18px, 3vw, 28px) - 4px);
        top: 26px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #f4f4f5;
        box-shadow: 0 0 0 4px #121215;
    }
    .proj-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }
    .proj-title {
        font-weight: 600;
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        margin: 0;
        color: #f4f4f5;
    }
    .proj-stack {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.04em;
        color: #86868b;
        white-space: nowrap;
    }
    .proj-desc {
        font-weight: 300;
        font-size: 0.98rem;
        line-height: 1.65;
        color: #a6a6ab;
        margin: 8px 0 0;
        max-width: 66ch;
    }

    @media (max-width: 600px) {
        .section { padding: 56px 20px; }
        .section-label { margin-bottom: 28px; }
        .company { padding: 22px 18px; border-radius: 14px; }
        .company-period { padding-top: 0; }
        .company-name { font-size: 1.7rem; }
        .company-role { font-size: 0.92rem; }
        .company-desc { font-size: 0.92rem; line-height: 1.65; margin-top: 18px; }
        .projects { margin-top: 24px; padding-top: 22px; }
        .projects-label { margin-bottom: 18px; }
        .proj-list { padding-left: 18px; }
        .proj { padding: 16px 0; }
        .proj-head { gap: 4px; }
        .proj-title { font-size: 1.05rem; }
        .proj-stack { white-space: normal; font-size: 10px; }
        .proj-desc { font-size: 0.9rem; line-height: 1.6; }
        .proj::before { top: 22px; }
    }
</style>
