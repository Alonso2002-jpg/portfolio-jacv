---
import {useTranslations} from "../i18n/utils";
import {languageList} from "../i18n/ui";

const currentLang = Astro.currentLocale || "es"
const t = useTranslations(currentLang as keyof typeof languageList)
---

<header id="top" class="hero">
    <p class="hero-iam">{t("heroIam")}</p>
    <h1 class="hero-name">
        <span class="name-fill">ALONSO</span>
        <span class="name-stroke">CRUZ</span>
    </h1>
    <p class="hero-role">{t("heroRole")}</p>
    <p class="hero-loc">{t("heroLocation")}</p>

    <div class="furniture left">
        <div class="socials">
            <a href="https://github.com/Alonso2002-jpg" target="_blank" rel="noopener">GH</a>
            <a href="https://www.linkedin.com/in/jorge-alonso-cruz" target="_blank" rel="noopener">IN</a>
            <a href="mailto:jorgealonso0876@gmail.com">@</a>
        </div>
        <span class="index">.01</span>
    </div>

    <div class="scrollcue">
        <span class="track"><span class="dot"></span></span>
    </div>

    <div class="furniture right wide-only">
        <span class="version">{t("heroScrollHint")}</span>
        <span class="rule"></span>
    </div>
</header>

<style>
    .hero {
        position: relative;
        min-height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px clamp(20px, 5vw, 40px) 120px;
    }
    .hero-iam {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.45em;
        text-transform: uppercase;
        color: #86868b;
        margin: 0 0 22px;
        padding-left: 0.45em;
    }
    .hero-name {
        margin: 0;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 0.84;
        font-size: clamp(3.4rem, 16vw, 11rem);
    }
    .name-fill { display: block; color: #f4f4f5; }
    .name-stroke {
        display: block;
        color: transparent;
        -webkit-text-stroke: 1.4px rgba(244, 244, 245, 0.55);
    }
    .hero-role {
        font-family: 'JetBrains Mono', monospace;
        font-size: clamp(10px, 2.4vw, 13px);
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: #a6a6ab;
        margin: 28px 0 0;
        padding-left: 0.4em;
    }
    .hero-loc {
        font-weight: 400;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #5a5a5e;
        margin: 16px 0 0;
    }

    .furniture {
        position: absolute;
        bottom: clamp(24px, 5vw, 40px);
        display: flex;
    }
    .furniture.left {
        left: clamp(20px, 5vw, 40px);
        flex-direction: column;
        gap: 14px;
    }
    .socials {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }
    .socials a {
        display: inline-block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--social, #c7c7cc);
        text-decoration: none;
        transition: color 0.25s, transform 0.25s, text-shadow 0.25s;
        transform-origin: left center;
        /* 3s loop; each icon fires 1s after the previous → GH → IN → @ → GH … */
        animation: socialChase 3s ease-in-out infinite;
    }
    /* Brand color + staggered start so only one is "on" at a time */
    .socials a:nth-child(1) { --social: #b392f0; animation-delay: 0s; }   /* GitHub  */
    .socials a:nth-child(2) { --social: #4d9fff; animation-delay: 1s; }   /* LinkedIn */
    .socials a:nth-child(3) { --social: #ff6f61; animation-delay: 2s; }   /* Email   */
    .socials a:hover {
        color: var(--social) !important;
        transform: scale(1.3) !important;
        text-shadow: 0 0 18px var(--social) !important;
    }

    @keyframes socialChase {
        0%, 44%, 100% {
            /* off: dim, tinted with its brand color */
            color: color-mix(in srgb, var(--social) 38%, #4d4d53);
            transform: scale(1);
            text-shadow: none;
        }
        22% {
            /* on: full brand color, bigger and glowing */
            color: var(--social);
            transform: scale(1.3);
            text-shadow: 0 0 16px currentColor;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .socials a { animation: none; }
    }
    .index {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: #3f3f43;
        letter-spacing: 0.05em;
    }

    .scrollcue {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        bottom: clamp(24px, 5vw, 38px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .track {
        display: inline-block;
        width: 1px;
        height: 30px;
        background: rgba(255, 255, 255, 0.16);
        position: relative;
        overflow: hidden;
    }
    .dot {
        position: absolute;
        inset: 0;
        background: #fff;
        animation: scrollcue 1.9s ease-in-out infinite;
    }

    .furniture.right {
        right: clamp(20px, 5vw, 40px);
        align-items: center;
        gap: 12px;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
    }
    .version {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        color: #5a5a5e;
    }
    .rule {
        width: 1px;
        height: 40px;
        background: rgba(255, 255, 255, 0.14);
    }

    @media (max-width: 760px) {
        .wide-only { display: none; }
    }
    @media (max-width: 600px) {
        .hero { padding: 72px 20px 96px; }
        .hero-iam { font-size: 10px; letter-spacing: 0.38em; margin-bottom: 16px; }
        .hero-name { font-size: clamp(2.3rem, 13vw, 3.2rem); line-height: 0.9; }
        .name-stroke { -webkit-text-stroke-width: 1px; }
        .hero-role { font-size: 10px; letter-spacing: 0.3em; margin-top: 18px; }
        .hero-loc { font-size: 10px; letter-spacing: 0.1em; margin-top: 12px; }
        .socials a, .index { font-size: 10px; }
    }
</style>
