---
import {useTranslations} from "../i18n/utils";
import {languageList} from "../i18n/ui";

const { currentLang } = Astro.props
const t = useTranslations(currentLang as keyof typeof languageList)
---

<section id="about" class="about section" data-reveal>
    <p class="section-label">{t("sectionAbout")} — 01</p>
    <div class="about-grid">
        <h2 class="about-headline">{t("aboutHeadline")}</h2>
        <div class="about-body">
            <p>{t("aboutP1")}</p>
            <p>{t("aboutP2")}</p>
        </div>
    </div>
</section>

<style>
    .section {
        max-width: 1180px;
        margin: 0 auto;
        padding: clamp(70px, 11vw, 130px) clamp(20px, 5vw, 40px);
        border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .section-label {
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #86868b;
        margin: 0 0 40px;
    }
    .about-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: clamp(32px, 5vw, 72px);
        align-items: start;
    }
    .about-headline {
        font-weight: 600;
        font-size: clamp(1.5rem, 3.4vw, 2.3rem);
        line-height: 1.28;
        letter-spacing: -0.01em;
        margin: 0;
        color: #f4f4f5;
        text-wrap: pretty;
    }
    .about-body p {
        font-weight: 300;
        font-size: 1.06rem;
        line-height: 1.75;
        color: #a6a6ab;
        margin: 0 0 20px;
    }
    .about-body p:last-child { margin-bottom: 0; }

    @media (max-width: 600px) {
        .section { padding: 56px 20px; }
        .section-label { margin-bottom: 26px; }
        .about-grid { gap: 22px; }
        .about-headline { font-size: 1.3rem; line-height: 1.32; }
        .about-body p { font-size: 0.92rem; line-height: 1.7; margin-bottom: 16px; }
    }
</style>
