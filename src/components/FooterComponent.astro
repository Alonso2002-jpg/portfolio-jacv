---
import {useTranslations} from "../i18n/utils";
import {languageList} from "../i18n/ui";

const currentLang = Astro.currentLocale || "es"
const t = useTranslations(currentLang as keyof typeof languageList)
---

<footer class="site-footer">
    <span class="foot-item">© 2026 Alonso Cruz — Madrid, ES</span>
    <span class="foot-item">{t("footerBuilt")}</span>
    <a href="#top" class="foot-link">{t("footerTop")} ↑</a>
</footer>

<style>
    .site-footer {
        max-width: 1180px;
        margin: 0 auto;
        padding: 36px clamp(20px, 5vw, 40px) 52px;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        justify-content: space-between;
    }
    .foot-item {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.05em;
        color: #5a5a5e;
    }
    .foot-link {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.05em;
        color: #86868b;
        text-decoration: none;
        transition: color 0.25s;
    }
    .foot-link:hover { color: #f4f4f5; }

    @media (max-width: 600px) {
        .site-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            padding: 28px 20px 40px;
        }
        .foot-item, .foot-link { font-size: 10px; }
        .foot-link {
            margin-top: 6px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.07);
            width: 100%;
        }
    }
</style>
