---
import ProjectTextComponent from "./ProjectTextComponent.astro";
import ProjectImageComponent from "./ProjectImageComponent.astro";
import ProjectImageCarouselComponent from "./ProjectImageCarouselComponent.astro";

const {projectsProps} = Astro.props
const hasCarousel = !!projectsProps.projectImage.images?.length
const isLeft = projectsProps.imgPosition === "left"
---

<div class="project-container">
    {isLeft && (
        hasCarousel
            ? <ProjectImageCarouselComponent projectImageProps={projectsProps.projectImage} />
            : <ProjectImageComponent projectImageProps={projectsProps.projectImage} />
    )}
    {isLeft
        ? <ProjectTextComponent projectTextProps={projectsProps.projectText} positionShape={projectsProps.imgPosition} />
        : <ProjectTextComponent projectTextProps={projectsProps.projectText}/>
    }
    {!isLeft && (
        hasCarousel
            ? <ProjectImageCarouselComponent projectImageProps={projectsProps.projectImage} />
            : <ProjectImageComponent projectImageProps={projectsProps.projectImage} positionShape={projectsProps.imgPosition}/>
    )}
</div>

<style>
    .project-container {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        justify-content: center;
        width: 100%;
        min-height: 460px;
        height: 500px;
        z-index: 1;
        margin-bottom: 1.5rem;

        @media (max-width: 780px) {
            flex-direction: column;
            height: auto;
            margin-bottom: 2rem;
        }
    }
</style>
