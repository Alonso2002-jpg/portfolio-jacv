---
const { projectImageProps } = Astro.props;
const images = projectImageProps.images!;
const imgSrcs: string[] = images.map((img: any) => img.src ?? img);
---

<div class="container" style={`background: ${projectImageProps.imgBg}`} data-carousel-root>
    <div class="image-wrapper">
        {imgSrcs.map((src: string, i: number) => (
            <div
                class={`image-slide${i === 0 ? ' active' : ''}`}
                style={`background-image: url(${src})`}
            ></div>
        ))}
    </div>
    <div class="dots">
        {imgSrcs.map((_: string, i: number) => (
            <button class={`dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Vista ${i + 1}`}></button>
        ))}
    </div>
</div>

<style>
    .container {
        width: 50%;
        height: 100%;
        min-height: 380px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        opacity: 1;
        transition: opacity .7s ease-in-out;
        flex-shrink: 0;
        position: relative;

        @media (max-width: 780px) {
            width: 100%;
            height: 310px;
            min-height: unset;
        }
    }

    .image-wrapper {
        width: 70%;
        height: 65%;
        min-height: 220px;
        position: relative;

        @media (max-width: 780px) {
            width: 85%;
            height: calc(100% - 2.5rem);
            min-height: unset;
        }
    }

    .image-slide {
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.19);
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.19), 6px 6px 6px rgba(0, 0, 0, 0.23);
        opacity: 0;
        transition: opacity 0.6s ease-in-out;
    }

    .image-slide.active {
        opacity: 1;
    }

    .dots {
        position: absolute;
        bottom: 1rem;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: none;
        background: rgba(255, 255, 255, 0.35);
        cursor: pointer;
        padding: 0;
        transition: background 0.3s, transform 0.3s;
    }

    .dot.active {
        background: rgba(255, 255, 255, 0.9);
        transform: scale(1.3);
    }

    .container:hover {
        opacity: .75;
    }
</style>

<script>
    function initCarousels() {
        document.querySelectorAll<HTMLElement>('[data-carousel-root]').forEach(root => {
            if (root.dataset.carouselInit) return;
            root.dataset.carouselInit = 'true';

            const slides = Array.from(root.querySelectorAll<HTMLElement>('.image-slide'));
            const dots = Array.from(root.querySelectorAll<HTMLElement>('.dot'));
            if (slides.length <= 1) return;

            let current = 0;
            let timer: ReturnType<typeof setInterval>;

            function showSlide(index: number) {
                slides[current].classList.remove('active');
                dots[current].classList.remove('active');
                current = index;
                slides[current].classList.add('active');
                dots[current].classList.add('active');
            }

            function startTimer() {
                timer = setInterval(() => {
                    showSlide((current + 1) % slides.length);
                }, 5000);
            }

            dots.forEach((dot, i) => {
                dot.addEventListener('click', () => {
                    clearInterval(timer);
                    showSlide(i);
                    startTimer();
                });
            });

            startTimer();
        });
    }

    initCarousels();
    document.addEventListener('astro:page-load', initCarousels);
</script>
